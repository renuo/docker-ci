#!/usr/bin/env bash
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "Usage: $0 <version>"
  echo "Example: $0 24.22.3"
  exit 1
fi

VERSION="$1"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

cd "${REPO_ROOT}"

sed -i "s/ARG NODE_VERSION=[0-9.]\+/ARG NODE_VERSION=${VERSION}/" Dockerfile
sed -i "s/NODE_VERSION: [0-9.]\+/NODE_VERSION: ${VERSION}/" .github/workflows/docker.yml

git add Dockerfile .github/workflows/docker.yml

if git diff --cached --quiet; then
  echo "No changes to commit"
else
  git commit -m "Update Node to ${VERSION}"
fi

echo "Bumped Node to ${VERSION}"
